    {
      "id": 9,
      "type": "canvas",
      "title": "Run capacity collection now",
      "description": "Click the button and confirm to queue an on-demand collection. It inserts a pending row into capacity_run_requests through the write-scoped datasource; the watcher on the collector host runs capacityutilization.ps1 and the panels above refresh once it reports done. Read-only collection - it never performs vMotion. Requires Edit permission on this dashboard.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
      },
      "pluginVersion": "12.2.0",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 9,
        "h": 5
      },
      "options": {
        "inlineEditing": false,
        "showAdvancedTypes": true,
        "panZoom": false,
        "infinitePan": false,
        "root": {
          "type": "frame",
          "name": "Element 1",
          "constraint": {
            "horizontal": "left",
            "vertical": "top"
          },
          "placement": {
            "top": 0,
            "left": 0,
            "width": 100,
            "height": 100,
            "rotation": 0
          },
          "background": {
            "color": {
              "fixed": "transparent"
            }
          },
          "border": {
            "color": {
              "fixed": "transparent"
            }
          },
          "elements": [
            {
              "type": "rectangle",
              "name": "Run capacity collection now",
              "config": {
                "align": "center",
                "valign": "middle",
                "color": {
                  "fixed": "#FFFFFF"
                },
                "size": 16,
                "text": {
                  "mode": "fixed",
                  "fixed": "\u25b6  Run capacity collection now"
                }
              },
              "background": {
                "color": {
                  "fixed": "dark-green"
                }
              },
              "border": {
                "color": {
                  "fixed": "transparent"
                },
                "width": 0
              },
              "constraint": {
                "horizontal": "left",
                "vertical": "top"
              },
              "placement": {
                "top": 16,
                "left": 16,
                "width": 300,
                "height": 52,
                "rotation": 0
              },
              "links": [],
              "actions": [
                {
                  "type": "fetch",
                  "title": "Run capacity collection now",
                  "oneClick": true,
                  "confirmation": "Queue a fresh VMware capacity collection now? This runs a read-only vCenter collection (no vMotion, no changes). The collector host picks the request up within about a minute.",
                  "fetch": {
                    "method": "POST",
                    "url": "/api/ds/query",
                    "headers": [
                      [
                        "Content-Type",
                        "application/json"
                      ]
                    ],
                    "body": "{\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"grafana-postgresql-datasource\",\"uid\":\"${DS_CAPACITY_TRIGGER}\"},\"rawQuery\":true,\"rawSql\":\"INSERT INTO capacity_run_requests (requested_by, note) VALUES ('${__user.login}', 'Manual refresh from Grafana dashboard')\",\"format\":\"table\"}],\"from\":\"now-5m\",\"to\":\"now\"}"
                  }
                }
              ]
            }
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
          },
          "rawQuery": true,
          "rawSql": "SELECT 1 AS ok;",
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Latest Manual Refresh Request",
      "description": "pending -> claimed -> done. 'superseded' means a duplicate or debounced click; 'failed' means the collector errored - check capacity_collection_runs.error_message for that run_id.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
      },
      "pluginVersion": "12.2.0",
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 15,
        "h": 5
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pending": {
                        "color": "blue",
                        "index": 0
                      },
                      "claimed": {
                        "color": "orange",
                        "index": 1
                      },
                      "done": {
                        "color": "green",
                        "index": 2
                      },
                      "failed": {
                        "color": "red",
                        "index": 3
                      },
                      "superseded": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "editorMode": "code",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
          },
          "rawQuery": true,
          "rawSql": "SELECT requested_at_utc AS \"Requested\", requested_by AS \"Requested By\", status AS \"Status\", completed_at_utc AS \"Completed\", run_id AS \"Run ID\" FROM capacity_run_requests ORDER BY requested_at_utc DESC LIMIT 1;",
          "format": "table"
        }
      ]
