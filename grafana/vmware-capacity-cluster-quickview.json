          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
          },
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT max(snapshot_ts_utc) AS ts FROM host_capacity_metrics) SELECT h.cluster_name AS \"Cluster\", h.compute_name AS \"Compute\", h.physical_cores AS \"Physical Cores\", h.reserved_cores AS \"Reserved Cores\", h.usable_cpu_cores AS \"Usable Cores\", h.overcommit_ratio AS \"Overcommit\", h.allowed_vcpu AS \"Allowed vCPU\", h.allocated_vcpu AS \"Allocated vCPU\", h.available_vcpu AS \"Available vCPU\", h.cpu_used_pct AS \"CPU Used %\", h.cpu_status AS \"CPU Status\", h.powered_on_vm_count AS \"Powered-On VMs\" FROM host_capacity_metrics h JOIN latest l ON h.snapshot_ts_utc = l.ts WHERE h.cluster_name IN (${cluster:sqlstring}) ORDER BY h.cluster_name, h.compute_name;",
