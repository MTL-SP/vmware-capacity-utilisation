            "type": "grafana-postgresql-datasource",
            "uid": "${DS_GRAFANA-POSTGRESQL-DATASOURCE}"
          },
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT max(snapshot_ts_utc) AS ts FROM host_capacity_metrics) SELECT sum(usable_cpu_cores) AS \"Usable Cores\", sum(allowed_vcpu) AS \"Overcommit vCPU\" FROM host_capacity_metrics h JOIN latest l ON h.snapshot_ts_utc = l.ts WHERE h.cluster_name = '$cluster';",
          "format": "table"
        }
      ]
