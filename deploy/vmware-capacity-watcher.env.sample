# Install as /etc/default/vmware-capacity-watcher (root:root, 644 - contains no secrets).
# This file is the only per-site difference for the watcher units.

# Site A:  DEPLOY_PATH=/var/www/vmware-capacity
# Site B:  DEPLOY_PATH=/opt/vmware-capacity
DEPLOY_PATH=/opt/vmware-capacity

# Collector config consumed by both the daily job and the watcher.
CONFIG_FILE=/opt/vmware-capacity/secrets/collector-config.psd1
